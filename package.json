{
  "name": "nice-downloader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test:integration": "cd src-tauri && cargo test engines::aria2::tests::integration_ -- --nocapture",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run engines:prepare && tauri build --config src-tauri/tauri.bundled.conf.json",
    "tauri:build:bundled": "npm run engines:prepare && tauri build --config src-tauri/tauri.bundled.conf.json",
    "tauri:build:bundled:prepared": "tauri build --config src-tauri/tauri.bundled.conf.json",
    "tauri:build:slim": "tauri build",
    "engines:prepare": "node scripts/prepare-bundled-engines.mjs",
    "tauri:build:appimage:arch": "bash scripts/build-appimage-arch.sh",
    "tauri:build:appimage:arch:slim": "bash scripts/build-appimage-arch.sh slim",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.8.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^7.0.0"
  }
}
